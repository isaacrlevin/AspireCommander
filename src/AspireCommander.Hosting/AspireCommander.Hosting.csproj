<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <PackageId>AspireCommander.Hosting</PackageId>
        <Version>0.2.0</Version>
        <Authors>AspireCommander contributors</Authors>
        <Description>Adds a Midnight Commander-inspired terminal file browser to any resource in a .NET Aspire AppHost.</Description>
        <PackageTags>aspire;hosting;terminal;tui;commander</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/isaacrlevin/AspireCommander</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting" Version="13.6.4"/>
        <!-- Built first and bundled as content; not referenced as an assembly. -->
        <ProjectReference Include="..\AspireCommander.Console\AspireCommander.Console.csproj"
                          ReferenceOutputAssembly="false"
                          SkipGetTargetFrameworkProperties="true"
                          Private="false"/>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md"/>
        <None Include="AspireCommander.Hosting.targets" Pack="true" PackagePath="build\$(PackageId).targets"/>
    </ItemGroup>

    <!-- Bundle the Console app's build output under commander\ (own output, and build\commander\ in the package). -->
    <Target Name="BundleCommanderConsole" AfterTargets="ResolveProjectReferences">
        <PropertyGroup>
            <CommanderConsoleDir>$(MSBuildProjectDirectory)\..\AspireCommander.Console\bin\$(Configuration)\$(TargetFramework)\</CommanderConsoleDir>
        </PropertyGroup>
        <ItemGroup>
            <_CommanderFile Include="$(CommanderConsoleDir)AspireCommander.Console.dll;$(CommanderConsoleDir)AspireCommander.Console.runtimeconfig.json"/>
            <Content Include="@(_CommanderFile)"
                     Link="commander\%(Filename)%(Extension)"
                     CopyToOutputDirectory="PreserveNewest"
                     Pack="true"
                     PackagePath="build\commander"/>
        </ItemGroup>
    </Target>
</Project>
